#!/usr/bin/env python3
import fcntl
import json
import os
import select
from pathlib import Path
import signal
import subprocess
import sys
import time
from urllib.parse import urlsplit

from core import FORMATS, Grabber, PlaylistRejected

STATE_DIR = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "videostorebar"
STATE_FILE = STATE_DIR / "state.json"
SETTINGS_FILE = STATE_DIR / "settings.json"
DOWNLOAD_LOCK = STATE_DIR / "download.lock"
WORKER_FILE = STATE_DIR / "worker.json"


def read_json(path):
    try:
        value = json.loads(path.read_text())
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def write_json(path, data):
    temporary = path.with_suffix(f".{os.getpid()}.tmp")
    temporary.write_text(json.dumps(data))
    temporary.replace(path)


def settings():
    config = read_json(SETTINGS_FILE)
    format_key = config.get("format")
    folder = config.get("outdir")
    outdir = Path(folder if isinstance(folder, str) and folder else Grabber.default_outdir()).expanduser()
    if not outdir.is_absolute():
        outdir = Path.home() / outdir
    return {
        "format": format_key if isinstance(format_key, str) and format_key in FORMATS else "label_best",
        "outdir": os.path.normpath(outdir),
    }


CLIPBOARD_LIMIT = 8192
CLIPBOARD_TIMEOUT = 2


def read_clipboard():
    deadline = time.monotonic() + CLIPBOARD_TIMEOUT
    with subprocess.Popen(
        ["wl-paste", "--no-newline"],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    ) as paste:
        data = bytearray()
        fd = paste.stdout.fileno()
        try:
            while len(data) <= CLIPBOARD_LIMIT:
                remaining = deadline - time.monotonic()
                if remaining <= 0 or not select.select([fd], [], [], remaining)[0]:
                    return None
                chunk = os.read(fd, CLIPBOARD_LIMIT + 1 - len(data))
                if not chunk:
                    return data if paste.wait(timeout=max(0, deadline - time.monotonic())) == 0 else None
                data.extend(chunk)
            return None
        finally:
            if paste.poll() is None:
                paste.kill()


def get_url():
    try:
        clipboard = read_clipboard()
        if clipboard is None:
            return None
        url = clipboard.decode("utf-8").strip()
        parsed = urlsplit(url)
    except (ValueError, OSError, subprocess.SubprocessError):
        return None
    if parsed.scheme in {"https", "http"} and parsed.hostname and not any(char.isspace() for char in url):
        return url
    return None


def process_start_time(pid):
    stat = Path(f"/proc/{pid}/stat").read_text()
    return stat.rsplit(")", 1)[1].split()[19]


def run_download(url, ready_fd):
    os.setsid()
    with open(os.devnull, "r+") as devnull:
        for fd in (0, 1, 2):
            os.dup2(devnull.fileno(), fd)

    grabber = Grabber()
    cancelled = False

    def cancel(signum, frame):
        nonlocal cancelled
        cancelled = True
        grabber.cancel()

    signal.signal(signal.SIGTERM, cancel)
    last = read_json(STATE_FILE).get("last", "none")

    def progress(percent):
        if cancelled:
            grabber.cancel()
        else:
            write_json(STATE_FILE, {"state": "downloading", "pct": percent, "last": last})

    try:
        progress(0)
        write_json(WORKER_FILE, {"pid": os.getpid(), "started": process_start_time(os.getpid())})
        os.write(ready_fd, b"1")
    finally:
        os.close(ready_fd)

    result = "failed"
    try:
        config = settings()
        command = grabber.build_cmd(url, config["format"], config["outdir"])
        if not cancelled:
            grabber.run(command, on_progress=progress, on_file=lambda _: None)
            result = "completed"
    except PlaylistRejected:
        result = "playlist"
    except (OSError, RuntimeError, ValueError):
        pass
    finally:
        write_json(STATE_FILE, {"state": "idle", "pct": 0, "last": "cancelled" if cancelled else result})
        WORKER_FILE.unlink(missing_ok=True)


def start_download():
    with DOWNLOAD_LOCK.open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return {"error": "A download is already running."}

        url = get_url()
        if not url:
            return {"error": "Copy one video URL to the clipboard (up to 8 KiB)."}

        read_fd, write_fd = os.pipe()
        pid = os.fork()
        if pid == 0:
            os.close(read_fd)
            try:
                run_download(url, write_fd)
            finally:
                os._exit(0)

        os.close(write_fd)
        with os.fdopen(read_fd, "rb") as ready:
            if ready.read(1) != b"1":
                return {"error": "Could not start the download."}
        return {"started": True}


def cancel_download():
    worker = read_json(WORKER_FILE)
    pid = worker.get("pid")
    if not isinstance(pid, int) or pid <= 0:
        return
    try:
        fd = os.pidfd_open(pid)
        try:
            if process_start_time(pid) == worker.get("started"):
                signal.pidfd_send_signal(fd, signal.SIGTERM)
        finally:
            os.close(fd)
    except (OSError, IndexError):
        return


def main():
    os.umask(0o077)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    command = sys.argv[1] if len(sys.argv) > 1 else ""
    if command == "status":
        with DOWNLOAD_LOCK.open("a") as lock:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                current = read_json(STATE_FILE)
                if current.get("state") == "downloading":
                    current = {"state": "idle", "pct": 0, "last": "failed"}
                    write_json(STATE_FILE, current)
            except BlockingIOError:
                current = read_json(STATE_FILE)
        print(json.dumps(current or {"state": "idle", "pct": 0, "last": "none"}))
    elif command == "settings":
        print(json.dumps(settings()))
    elif command == "set":
        with (STATE_DIR / "settings.lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            config = settings()
            for argument in sys.argv[2:]:
                key, sep, value = argument.partition("=")
                if sep and key == "format" and value in FORMATS:
                    config[key] = value
                if sep and key == "outdir" and value:
                    path = Path(value).expanduser()
                    config[key] = os.path.normpath(path if path.is_absolute() else Path.home() / path)
            write_json(SETTINGS_FILE, config)
        print(json.dumps(config))
    elif command == "start":
        print(json.dumps(start_download()))
    elif command == "cancel":
        cancel_download()
    else:
        sys.exit("usage: vsb-daemon start|cancel|status|settings|set")


if __name__ == "__main__":
    main()
